{
  "name": "excalidraw-e2e",
  "private": true,
  "description": "Playwright E2E tests for Excalidraw (pinned release, run locally)",
  "scripts": {
    "setup:app": "bash scripts/setup-app.sh",
    "test": "playwright test",
    "test:repeat": "playwright test --repeat-each=10",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
